SESSION_SECRET=
# Test veröffentlicht nach test.aluna-tierhilfe.org
SITE_PUBLIC_URL=https://test.aluna-tierhilfe.org
SITE_STAGING=1
SITE_DEPLOY_HOST=<webspace>.1and1-data.host
SITE_DEPLOY_USER=<webspace-benutzer>
SITE_DEPLOY_PATH=/kunden/homepages/<NN>/<dNNNNNNNNN>/htdocs/aluna-test
# IONOS-Webhosting kennt keine SSH-Schlüssel; das Passwort steht in einer
# Datei (Rechte 600), nicht in einer Variablen — sonst stünde es in
# `docker inspect`. Alternativ SITE_DEPLOY_KEY_FILE für Schlüssel-Login.
SITE_DEPLOY_PASSWORD_FILE=/data/site.pw
