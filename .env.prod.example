SESSION_SECRET=
# Die spitzen Klammern durch die echten Werte aus dem IONOS-Kundencenter
# ersetzen. Diese Datei ist eine Vorlage; die ausgefuellte .env.prod liegt nur
# auf dem NAS und ist gitignoriert.
# Bis zum Domainwechsel läuft Prod unter prod.aluna-tierhilfe.org.
# SITE_STAGING=1 hält diese Vorabfassung aus dem Index; beim Go-live
# zusammen mit SITE_PUBLIC_URL umstellen und einmal neu publizieren.
SITE_PUBLIC_URL=https://prod.aluna-tierhilfe.org
SITE_STAGING=1
SITE_DEPLOY_HOST=<webspace>.1and1-data.host
SITE_DEPLOY_USER=<webspace-benutzer>
SITE_DEPLOY_PATH=/kunden/homepages/<NN>/<dNNNNNNNNN>/htdocs/aluna-prod
SITE_DEPLOY_PASSWORD_FILE=/secret/site.pw
