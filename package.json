{
  "name": "aluna-kompass",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @kompass/app dev",
    "e2e": "pnpm --filter @kompass/app e2e",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "image": "docker build --platform linux/amd64 -t kompass-local .",
    "verify": "pnpm typecheck && pnpm test && pnpm --filter @kompass/app e2e && pnpm image",
    "import:prototype": "tsx scripts/import-prototype.ts",
    "dev:reset": "tsx scripts/dev-reset.ts"
  },
  "devDependencies": {
    "@kompass/core": "workspace:*",
    "@kompass/documents": "workspace:*",
    "@kompass/module-animals": "workspace:*",
    "@kompass/module-site": "workspace:*",
    "@kompass/site-template": "workspace:*",
    "tsx": "^4.19.3"
  }
}
