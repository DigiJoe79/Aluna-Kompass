{
  "name": "aluna-kompass",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @kompass/app dev",
    "e2e": "pnpm --filter @kompass/app e2e",
