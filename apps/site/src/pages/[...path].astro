---
import TextPage from '../components/TextPage.astro';
import HomePage from '../components/HomePage.astro';
import DogList from '../components/DogList.astro';
import DogPage from '../components/DogPage.astro';
import StoryList from '../components/StoryList.astro';
import ProjectList from '../components/ProjectList.astro';
import ProjectPage from '../components/ProjectPage.astro';
import ArticleList from '../components/ArticleList.astro';
import ArticlePage from '../components/ArticlePage.astro';
import FaqPage from '../components/FaqPage.astro';
import TeamPage from '../components/TeamPage.astro';
import BetterplaceEmbed from '../components/BetterplaceEmbed.astro';
import DownloadCard from '../components/DownloadCard.astro';
import MailtoCard from '../components/MailtoCard.astro';
import { loadContent, pageOf, animalsOf, factsOf } from '../lib/content';
import { loadImages } from '../lib/images';
import { ui, type Locale } from '../lib/locale';
import { paramFor, pathFor, type Kind } from '../lib/routes';

export async function getStaticPaths() {
  const locales: Locale[] = ['de', 'en'];
  const textKinds: Kind[] = [
    'help',
    'donate',
    'sponsor',
    'membership',
    'about',
    'partners',
    'contact',
    'imprint',
    'privacy',
    'statutes',
    'adoption-process',
  ];
  const listKinds: Kind[] = ['dogs', 'stories', 'projects', 'articles', 'faq', 'team'];

  const content = await loadContent();
  const paths: { params: { path: string | undefined }; props: { kind: Kind; locale: Locale; slug?: string } }[] = [];

  for (const locale of locales) {
    paths.push({ params: { path: paramFor(pathFor('home', locale)) }, props: { kind: 'home', locale } });
    for (const kind of textKinds) {
      paths.push({ params: { path: paramFor(pathFor(kind, locale)) }, props: { kind, locale } });
    }
    for (const kind of listKinds) {
      paths.push({ params: { path: paramFor(pathFor(kind, locale)) }, props: { kind, locale } });
    }
    for (const dog of content.animals ?? []) {
      paths.push({ params: { path: paramFor(pathFor('dog', locale, dog.slug)) }, props: { kind: 'dog', locale, slug: dog.slug } });
    }
    for (const project of content.projects ?? []) {
      paths.push({ params: { path: paramFor(pathFor('project', locale, project.slug)) }, props: { kind: 'project', locale, slug: project.slug } });
    }
    for (const article of content.articles ?? []) {
      paths.push({ params: { path: paramFor(pathFor('article', locale, article.slug)) }, props: { kind: 'article', locale, slug: article.slug } });
    }
  }
  return paths;
}

const { kind, locale, slug } = Astro.props as { kind: Kind; locale: Locale; slug?: string };
const content = await loadContent();
const images = await loadImages();
const facts = factsOf(content);
const org = facts.organization;
const t = ui(locale);

const eyebrows: Record<string, string> = {
  help: t.nav.help,
  donate: t.cta.donate,
  sponsor: t.cta.sponsor,
  membership: locale === 'de' ? 'Fördermitglied werden' : 'Supporting membership',
  about: t.nav.about,
  partners: locale === 'de' ? 'Unsere Partner' : 'Our partners',
  contact: t.footer.contact,
  imprint: t.footer.imprint,
  privacy: t.footer.privacy,
  statutes: locale === 'de' ? 'Vereinssatzung' : 'Statutes',
  'adoption-process': locale === 'de' ? 'Ablauf der Adoption' : 'Adoption process',
};

const activeFor: Partial<Record<Kind, string>> = {
  help: 'help',
  donate: 'help',
  sponsor: 'help',
  membership: 'help',
  about: 'about',
  partners: 'about',
  team: 'about',
  articles: 'about',
  article: 'about',
  dogs: 'dogs',
  dog: 'dogs',
  stories: 'dogs',
  projects: 'projects',
  project: 'projects',
  faq: 'faq',
  contact: 'faq',
};

const animals = animalsOf(content);
const sponsorableDogs = animals.filter((d) => d.isSponsorable && d.status !== 'adopted');
const sponsorDownload = content.downloads?.find((d) => d.key === 'sponsorship-form');
const membershipDownload = content.downloads?.find((d) => d.key === 'membership-form');
const statutesDownload = content.downloads?.find((d) => d.key === 'statutes-pdf');
---
{kind === 'home' ? (
  <HomePage locale={locale} />
) : kind === 'dogs' ? (
  <DogList locale={locale} />
) : kind === 'dog' ? (
  <DogPage dog={animals.find((a) => a.slug === slug)!} locale={locale} images={images} />
) : kind === 'stories' ? (
  <StoryList locale={locale} />
) : kind === 'projects' ? (
  <ProjectList locale={locale} />
) : kind === 'project' ? (
  <ProjectPage project={content.projects.find((p) => p.slug === slug)!} locale={locale} images={images} />
) : kind === 'articles' ? (
  <ArticleList locale={locale} />
) : kind === 'article' ? (
  <ArticlePage article={content.articles.find((a) => a.slug === slug)!} locale={locale} />
) : kind === 'faq' ? (
  <FaqPage locale={locale} />
) : kind === 'team' ? (
  <TeamPage locale={locale} />
) : (
  <TextPage
    page={pageOf(content, kind)}
    locale={locale}
    eyebrow={eyebrows[kind] ?? ''}
    active={activeFor[kind]}
    wide={kind === 'help' || kind === 'donate'}
  >
    {kind === 'donate' && (
      <div slot="top" style="margin-bottom:40px">
        <BetterplaceEmbed projectId={facts.betterplaceMetaProjectId} defaultAmount={facts.betterplaceDefaultAmount} locale={locale} label={locale === 'de' ? 'das Dauerprojekt von Aluna' : 'Aluna long-term project'} />
      </div>
    )}

    {kind === 'donate' && (
      <div class="bank-card" style="margin-top:40px">
        <h3>{locale === 'de' ? 'Bankverbindung für Direktüberweisungen' : 'Bank details for direct transfers'}</h3>
        <p class="bank-data">{org.name}<br />IBAN {org.iban}<br />BIC {org.bic}<br />{org.bankName}</p>
      </div>
    )}

    {kind === 'sponsor' && (
      <div style="margin-top:32px">
        {sponsorDownload && <DownloadCard download={sponsorDownload} locale={locale} email={org.email ?? 'info@example.org'} />}
        {sponsorableDogs.length > 0 && (
          <p class="prose" style="margin-top:24px">
            {locale === 'de' ? 'Aktuell suchen diese Hunde einen Paten: ' : 'These dogs are currently looking for a sponsor: '}
            {sponsorableDogs.map((d, i) => (
              <span>{i > 0 ? ', ' : ''}<a href={pathFor('dog', locale, d.slug)}>{d.name}</a></span>
            ))}.
          </p>
        )}
      </div>
    )}

    {kind === 'membership' && membershipDownload && (
      <div style="margin-top:32px">
        <DownloadCard download={membershipDownload} locale={locale} email={org.email ?? 'info@example.org'} />
      </div>
    )}

    {kind === 'statutes' && statutesDownload && (
      <p style="margin-top:24px">
        <a class="btn btn-primary" href={`/downloads/${statutesDownload.key}.pdf`}>{locale === 'de' ? 'Satzung als PDF herunterladen' : 'Download statutes as PDF'}</a>
      </p>
    )}

    {kind === 'contact' && (
      <div style="margin-top:32px">
        <MailtoCard
          email={org.email ?? 'info@example.org'}
          subject={locale === 'de' ? 'Allgemeine Anfrage' : 'General inquiry'}
          title={locale === 'de' ? 'Per E-Mail' : 'By email'}
          description={locale === 'de' ? `Am schnellsten erreichst du uns unter ${org.email ?? 'info@example.org'}. Wähl unten am besten gleich das passende Thema — dann ist der Betreff schon gesetzt.` : `The fastest way to reach us is at ${org.email ?? 'info@example.org'}. Choose a topic below to prefill the subject.`}
          buttonLabel={locale === 'de' ? 'Allgemeine Anfrage' : 'General inquiry'}
          extraButtons={[
            { label: locale === 'de' ? 'Zu einer Adoption' : 'About adoption', subject: locale === 'de' ? 'Frage zu einer Adoption' : 'Question about adoption' },
            { label: locale === 'de' ? 'Zu einer Spende' : 'About donations', subject: locale === 'de' ? 'Frage zu Spende / Spendenbescheinigung' : 'Question about donation' },
            { label: locale === 'de' ? 'Presse / Kooperation' : 'Press / cooperation', subject: locale === 'de' ? 'Presse / Kooperation' : 'Press / cooperation' },
          ]}
        />
        <div class="prose" style="margin-top:40px">
          <h2>{locale === 'de' ? 'Per Post' : 'By post'}</h2>
          <p>{org.name}<br />{org.address}</p>
        </div>
      </div>
    )}
  </TextPage>
)}
