---
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import { factsOf, loadContent } from '../lib/content';
import { pick, ui, type Locale } from '../lib/locale';

const { locale } = Astro.props as { locale: Locale };
const content = await loadContent();
const facts = factsOf(content);
const email = facts.organization.email ?? 'info@example.org';
const t = ui(locale);
const listInfo = t.lists.faq;

const groups: { category: string; categoryFallback: 'de' | null; faqs: typeof content.faqs }[] = [];
for (const f of [...content.faqs].sort((a, b) => a.sortOrder - b.sortOrder)) {
  const cat = pick(f.category, locale);
  let g = groups.find((grp) => grp.category === cat.value);
  if (!g) {
    g = { category: cat.value, categoryFallback: cat.fallback, faqs: [] };
    groups.push(g);
  }
  g.faqs.push(f);
}
---
<Base title={listInfo.eyebrow} description={listInfo.lede} locale={locale} active="faq">
  <div class="aluna-page">
    <div class="wrap wrap-narrow">
      <PageHeader eyebrow={listInfo.eyebrow} title={listInfo.title} lede={listInfo.lede} narrow />

      <div class="faq">
        {groups.map((group) => (
          <div>
            <h2 data-fallback={group.categoryFallback ?? undefined}>{group.category}</h2>
            {group.faqs.map((f) => {
              const q = pick(f.question, locale);
              const a = pick(f.answer, locale);
              return (
                <details>
                  <summary data-fallback={q.fallback ?? undefined}>{q.value}</summary>
                  <p data-fallback={a.fallback ?? undefined}>{a.value}</p>
                </details>
              );
            })}
          </div>
        ))}
      </div>

      <p class="aluna-note">
        {locale === 'de' ? (
          <>Deine Frage war nicht dabei? Schreib uns an <a href={`mailto:${email}`}>{email}</a> — wir helfen gern weiter.</>
        ) : (
          <>Did not find what you were looking for? Email us at <a href={`mailto:${email}`}>{email}</a> — we are happy to help.</>
        )}
      </p>
    </div>
  </div>
</Base>
