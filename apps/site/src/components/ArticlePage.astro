---
import Base from '../layouts/Base.astro';
import MarkdownBody from './MarkdownBody.astro';
import type { Article } from '../lib/content';
import { pick, ui, type Locale } from '../lib/locale';
import { pathFor } from '../lib/routes';

const { article, locale } = Astro.props as { article: Article; locale: Locale };
const t = ui(locale);
const title = pick(article.title, locale);
const lede = pick(article.lede, locale);
const body = pick(article.body, locale);
---
<Base title={title.value} description={lede.value.slice(0, 155)} locale={locale} active="about">
  <div class="aluna-page">
    <div class="wrap wrap-narrow">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{t.lists.articles.eyebrow}</p>
      <h1 class="section-title" style="margin-bottom:24px" data-fallback={title.fallback ?? undefined}>{title.value}</h1>
      <p class="section-lede" style="margin-bottom:40px" data-fallback={lede.fallback ?? undefined}>{lede.value}</p>
      <MarkdownBody markdown={body.value} fallback={body.fallback} />
      <p style="margin-top:48px"><a class="link link-arrow" href={pathFor('articles', locale)}>{t.cta.backToArticles}</a></p>
    </div>
  </div>
</Base>
