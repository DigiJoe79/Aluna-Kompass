---
import Base from '../layouts/Base.astro';
import BetterplaceEmbed from './BetterplaceEmbed.astro';
import MarkdownBody from './MarkdownBody.astro';
import type { Project } from '../lib/content';
import { imageFor, type ImageVariant } from '../lib/images';
import { pick, ui, type Locale } from '../lib/locale';
import { pathFor } from '../lib/routes';

const { project, locale, images } = Astro.props as { project: Project; locale: Locale; images: Record<string, ImageVariant> };
const t = ui(locale);
const name = pick(project.name, locale);
const summary = pick(project.summary, locale);
const body = pick(project.body, locale);
const img = imageFor(images, project.imageAssetId);
const isShortTerm = project.type === 'shortTerm';
const tagText = isShortTerm ? t.project.shortTerm : t.project.ongoing;
---
<Base title={name.value} description={summary.value} locale={locale} active="projects" hideAktuelles>
  <div class="aluna-page">
    <div class="wrap">
      <p class="eyebrow"><span class="eyebrow-dot"></span>{t.lists.projects.eyebrow} · {tagText}</p>
      <h1 class="section-title" style="margin-bottom:24px" data-fallback={name.fallback ?? undefined}>{name.value}</h1>

      {img ? (
        <img src={img.src} srcset={img.srcset} alt={name.value} width={img.width} height={img.height} style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:22px;margin-bottom:40px" />
      ) : (
        <img src="/images/placeholder-projekt.jpg" alt={name.value} width="960" height="540" style="width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:22px;margin-bottom:40px" />
      )}

      <MarkdownBody markdown={body.value} fallback={body.fallback} />

      <h2 style="margin-top:40px">{t.project.donateFor}</h2>
      <div style="max-width:620px;margin-top:24px">
        <BetterplaceEmbed projectId={project.betterplaceProjectId} locale={locale} label={`„${name.value}“`} />
      </div>

      <p class="aluna-note">{t.bp.note}</p>
      <p style="margin-top:40px"><a class="link link-arrow" href={pathFor('projects', locale)}>{t.cta.backToProjects}</a></p>
    </div>
  </div>
</Base>
