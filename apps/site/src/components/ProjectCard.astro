---
import type { Project } from '../lib/content';
import { imageFor, type ImageVariant } from '../lib/images';
import { pick, ui, type Locale } from '../lib/locale';
import { pathFor } from '../lib/routes';

const { project, locale, images } = Astro.props as { project: Project; locale: Locale; images: Record<string, ImageVariant> };
const t = ui(locale);
const name = pick(project.name, locale);
const summary = pick(project.summary, locale);
const img = imageFor(images, project.imageAssetId);
const isShortTerm = project.type === 'shortTerm';
const tagText = isShortTerm ? t.project.shortTerm : t.project.ongoing;
---
<article class="project-card">
  <a class="project-photo" href={pathFor('project', locale, project.slug)}>
    {img ? (
      <img src={img.src} srcset={img.srcset} alt={name.value} loading="lazy" width={img.width} height={img.height} />
    ) : (
      <img src="/images/placeholder-projekt.jpg" alt={name.value} loading="lazy" width="640" height="400" />
    )}
    <span class:list={['project-tag', isShortTerm && 'project-tag-kurz']}>{tagText}</span>
  </a>
  <div class="project-body">
    <h3 class="project-title" data-fallback={name.fallback ?? undefined}>{name.value}</h3>
    <p class="project-text" data-fallback={summary.fallback ?? undefined}>{summary.value}</p>
    <div class="project-actions">
      <a class="link link-arrow" href={pathFor('project', locale, project.slug)}>{t.cta.toProject}</a>
    </div>
  </div>
</article>
