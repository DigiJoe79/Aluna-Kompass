---
import Base from '../layouts/Base.astro';
import { emphasize, ui, type Locale } from '../lib/locale';
import { pathFor } from '../lib/routes';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const lede = locale === 'de' ? 'Die gesuchte Seite gibt es nicht (mehr).' : 'This page does not exist (any more).';
---
<Base title="404" locale={locale}>
  <div class="aluna-page">
    <div class="wrap wrap-narrow" style="text-align:center">
      <p class="eyebrow" style="justify-content:center"><span class="eyebrow-dot"></span>{locale === 'de' ? 'Fehler 404' : 'Error 404'}</p>
      <h1 class="section-title" set:html={emphasize(t.misc.notFound)}></h1>
      <p class="section-lede" style="margin-inline:auto">{lede}</p>
      <p style="margin-top:32px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-primary" href={pathFor('home', locale)}>{t.misc.home}</a>
      </p>
    </div>
  </div>
</Base>
