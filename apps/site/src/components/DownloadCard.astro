---
import type { Download } from '../lib/content';
import { pick, type Locale } from '../lib/locale';

const { download, locale, email } = Astro.props as { download: Download; locale: Locale; email: string };
const title = pick(download.title, locale);
const docIcon = '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>';
const askSubject = encodeURIComponent(locale === 'de' ? `Frage zu ${title.value}` : `Question regarding ${title.value}`);
---
<div class="pdf-card">
  <div class="pdf-ico"><Fragment set:html={docIcon} /></div>
  <div>
    <h3 data-fallback={title.fallback ?? undefined}>{title.value}</h3>
    <p>{locale === 'de'
      ? 'Statt eines Online-Formulars nutzen wir ein ausfüllbares PDF. So speichert die Webseite keine deiner Daten — du entscheidest selbst, wann und wie du sie an uns übermittelst.'
      : 'Instead of an online form, we use a fillable PDF. This way our website does not store any personal data — you decide how and when to submit it.'}</p>
    <ol>
      <li>{locale === 'de' ? 'PDF herunterladen und am Rechner oder ausgedruckt ausfüllen' : 'Download the PDF and fill it out digitally or printed'}</li>
      <li>{locale === 'de' ? `unterschrieben per E-Mail an ${email} senden oder per Post an die im Impressum genannte Anschrift` : `send the signed form by email to ${email} or by post to our legal address`}</li>
      <li>{locale === 'de' ? 'wir bestätigen deinen Antrag und melden uns mit den nächsten Schritten' : 'we confirm your application and follow up with the next steps'}</li>
    </ol>
    <div class="pdf-actions">
      <a class="btn btn-primary" href={`/downloads/${download.key}.pdf`}>{title.value} (PDF)</a>
      <a class="btn btn-ghost" href={`mailto:${email}?subject=${askSubject}`}>{locale === 'de' ? 'Erst eine Frage stellen' : 'Ask a question first'}</a>
    </div>
  </div>
</div>
